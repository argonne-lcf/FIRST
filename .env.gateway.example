# Gateway secrets: copy to .env.secret.gateway (gitignored) and fill in.
# Read only by `inference-gateway`, the internet-facing process. See
# docs/deployment/docker.md ("Environment files").
#
# Never add a credential that can submit work to a cluster
# (FIRST_GLOBUS__COMPUTE_CLIENT_*, FIRST_KEYCLOAK_CLIENTS): those belong in
# .env.secret.controller. The gateway refuses to start with them.

# --- Globus resource-server app (introspects user tokens) ---
FIRST_GLOBUS__APP_ID=
FIRST_GLOBUS__APP_SECRET=

# --- Data staging: Transfer-only confidential app, access manager on the
# staging collection (FIRST_DATA_STAGING_GLOBUS_COLLECTION_ID). Leave unset
# and the staging routes return 503.
FIRST_DATA_STAGING_CLIENT_ID=
FIRST_DATA_STAGING_CLIENT_SECRET=

# --- Static backend API keys: one line per `env_var://NAME` that the
# StaticDeployment specs reference (Metis, Minerva). Names must start with
# FIRST_UPSTREAM_KEY_ (other names are rejected), e.g.
FIRST_UPSTREAM_KEY_METIS_GPT_OSS_120B=

# --- Database (prod; in dev .env.compose sets it and wins) ---
FIRST_DB_URL=
