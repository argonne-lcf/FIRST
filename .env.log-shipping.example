# Log shipping settings: copy to .env.secret.log-shipping (gitignored) and fill in.
# Read by the `vector` and `prompt-shipper` services only; the gateway and
# controller never see these credentials. See docs/deployment/log-shipping.md.
#
# Values are used verbatim: no quotes, no trailing comments.

# --- S3: structured-log archive (Vector) and large bodies (rclone) ---
S3_ENDPOINT=https://camel-data-s3.lab.alcf.anl.gov:443
# inference-service-dev on the Dev VM, inference-service-prod on Prod.
S3_BUCKET=inference-service-dev
# The bucket's read-write key pair.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The endpoint's CA: copy the PEM to pki/log-shipping/s3-ca.pem on the host.
S3_CA_FILE=/etc/log-shipping/pki/s3-ca.pem

# --- ClickHouse: structured logs (Vector) ---
CLICKHOUSE_ENDPOINT=https://inference-olap-01.cels.anl.gov:8443
CLICKHOUSE_DATABASE=analytics
# On a test host point this at a scratch table with the same columns.
CLICKHOUSE_TABLE=gateway_logs
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=
# The ClickHouse CA: copy it to
# pki/log-shipping/clickhouse-ca.crt on the host.
CLICKHOUSE_CA_FILE=/etc/log-shipping/pki/clickhouse-ca.crt
