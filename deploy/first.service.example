# systemd unit for FIRSTv2 Docker Compose stack
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now first.service
#
# One-time before first start: `make prod-init` (creates the external volumes).
# Migrations stay manual: after deploying a new image run `make prod-migrate`.
#
# This is a lightweight oneshot wrapper: Compose's own `restart: unless-stopped`
# keeps individual containers alive while dockerd runs; this unit ties the whole
# stack's lifecycle to boot/shutdown and ordering after docker.

[Unit]
Description=FIRSTv2 Docker Compose stack
Wants=snap.docker.dockerd.service
After=snap.docker.dockerd.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/webportal/FIRSTv2
User=webportal
Group=webportal
ExecStartPre=-/snap/bin/docker compose pull --quiet
ExecStart=/snap/bin/docker compose up -d --remove-orphans
ExecReload=/snap/bin/docker compose up -d --remove-orphans --wait
ExecStop=/snap/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
