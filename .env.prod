# !!! WARNING !!!  Do not put secrets in this file.
# It is tracked in git.
# Sensitive variables should go into .env.secret instead.

# Non-secret settings specific to production deployment.
# Loaded only by the prod overlay (deploy/compose.prod.yaml).

POSTGRES_DB=first_gateway
POSTGRES_USER=first_gateway

FIRST_REDIS_URL="redis://redis:6380/1"
FIRST_GATEWAY_HEALTH_URL=http://inference-gateway:7000/health

# Secrets that MUST be set in .env.secret on the prod host (not tracked):
#   POSTGRES_PASSWORD=<strong-password>
#   FIRST_DB_URL="postgresql+psycopg://first_gateway:<strong-password>@postgres:5432/first_gateway"
