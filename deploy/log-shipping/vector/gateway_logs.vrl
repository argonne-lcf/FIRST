# One gateway log line -> one analytics.gateway_logs row.
#
# Shared by the V1 and V2 pipelines (rows_v1, rows_v2). The mapping is the one
# the table was built around (FIRST-analytics templates/vector.yaml.j2) and
# the twin of FIRST-analytics scripts/backfill-gateway-logs.sql: keep them in
# step.
#
# .message is the app's JSONL line on input. The parsed fields are merged on
# top and the line's own `message` becomes `log_message`.
#
# Request and response content never reaches ClickHouse: `body` (V2) and
# `prompt` / `result` (V1) are dropped, and `raw` / `message` hold the line
# re-encoded without them. The S3 archive is fed before this mapping and keeps
# every line byte for byte. `body_stored` stays: it says a body was spilled to
# the prompt store, not what it said. Re-encoding is deterministic (keys are
# sorted), so a redelivered line still yields an identical row for
# gateway_logs to collapse.

.raw = .message

parsed, err = parse_json(.message)
if err == null && is_object(parsed) {
  line = remove!(remove!(remove!(object!(parsed), ["body"]), ["prompt"]), ["result"])
  . = merge(., line)
  # The line's own message only: a line without one (V1 request_log and
  # friends) once copied the whole input line here, content and all.
  .log_message = string(line.message) ?? ""
  .raw = encode_json(line)
  .message = .raw
} else {
  .unparsed = true
}

# user.name and user.id are dotted keys that need remapping; they are
# not duplicates (different event types).
if exists(."user.name") {
  .user_name = ."user.name"
  del(."user.name")
}
if exists(."user.id") {
  .user_id = ."user.id"
  del(."user.id")
}

# Pipeline bookkeeping, not log content.
del(.partial)
