upstream app_server {
    server 127.0.0.1:7001;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      "";
}

# The CELS front-end proxies forward requests to this host. The client address
# is taken from X-Forwarded-For only when the request comes from one of these
# proxies; otherwise $remote_addr stays the socket peer. Replace the
# placeholders with the real front-end proxy ranges.
set_real_ip_from <CELS-FRONT-END-PROXY-RANGE-1>;   # <-- placeholder
set_real_ip_from <CELS-FRONT-END-PROXY-RANGE-2>;   # <-- placeholder
real_ip_header X-Forwarded-For;

# Rate limit keyed per client address (as resolved by real_ip above).
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=50r/s;
limit_req_status 429;

server {
    listen 443 ssl;
    http2 on;
    server_name inference-api.alcf.anl.gov;
    client_max_body_size 20M;

    ssl_certificate     /etc/ssl/first/fullchain.pem;
    ssl_certificate_key /etc/ssl/first/privkey.pem;

    # No admin routes here: the admin API and the admin console are served only
    # by controller-manager on 127.0.0.1:9100. Do not proxy to that port.

    location / {
        limit_req zone=api_limit burst=50 nodelay;

        proxy_pass http://app_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # The gateway logs this as the request's origin address.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;

        # Stream SSE without buffering (preserves TTFT/ITL).
        proxy_buffering off;
        gzip off;

        proxy_connect_timeout 600s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        send_timeout 900s;
    }
}
