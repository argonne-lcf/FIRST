# Copy to .env and edit. Used by compose.yaml.
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.6.5
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=<set-a-strong-password>

# Passwords for the two least-privilege users created by schema.sql.
# CLICKHOUSE_VECTOR_PASSWORD is what vector/.env uses;
# CLICKHOUSE_GRAFANA_PASSWORD is what grafana/.env uses.
CLICKHOUSE_VECTOR_PASSWORD=<set-a-strong-password>
CLICKHOUSE_GRAFANA_PASSWORD=<set-a-strong-password>

# 8443 is the TLS endpoint Vector writes to from VM1. 9440 is the secure
# native port Grafana uses; compose.yaml pins it to loopback.
CLICKHOUSE_HTTPS_PORT=8443
CLICKHOUSE_SECURE_NATIVE_PORT=9440

# VM2's private address. The design doc requires 8443 to be reachable only
# from VM1, so do not publish it on 0.0.0.0.
BIND_ADDRESS=127.0.0.1
ANALYTICS_NETWORK=first-analytics

# Must exist and be writable by the container's clickhouse user (uid 101).
CLICKHOUSE_DATA_DIR=/srv/clickhouse/data
CLICKHOUSE_LOGS_DIR=/srv/clickhouse/logs
