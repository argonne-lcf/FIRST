# Controller secrets: copy to .env.secret.controller (gitignored) and fill in.
# Read only by `controller-manager`, which is not reachable from the internet
# (control server on 127.0.0.1:9100). See docs/deployment/docker.md
# ("Environment files").

# --- Globus resource-server app: the control server's admin API
# (first-admin) authenticates operators with it, like the gateway does.
FIRST_GLOBUS__APP_ID=
FIRST_GLOBUS__APP_SECRET=

# --- Cluster credentials (controller only) ---
# Globus Compute client: submits and polls pilot jobs on Globus Compute
# clusters (Sophia).
FIRST_GLOBUS__COMPUTE_CLIENT_ID=
FIRST_GLOBUS__COMPUTE_CLIENT_SECRET=
# Keycloak impersonation clients for GraphQL PBS clusters (Tara), as JSON:
#   {"tara-pbs": {"base_url": "...", "realm": "...",
#     "impersonation_client_id": "...", "impersonation_client_secret": "...",
#     "audience": "...", "requested_subject": "..."}}
FIRST_KEYCLOAK_CLIENTS={}

# --- Health alerter (Slack) ---
FIRST_HEALTH_SLACK_BOT_TOKEN=
FIRST_HEALTH_SLACK_CHANNEL=

# --- Static backend API keys, for health checks: the same lines as in
# .env.secret.gateway, e.g.
METIS_API_KEY_GPT_OSS_120B=

# --- Database (prod; in dev .env.compose sets it and wins) ---
FIRST_DB_URL=
