# Postgres secret: copy to .env.secret.postgres (gitignored) and fill in.
# Read only by `postgres` in the prod overlay (POSTGRES_DB and POSTGRES_USER
# are set in deploy/compose.prod.yaml). It must match the password in
# FIRST_DB_URL in .env.secret.gateway and .env.secret.controller.
# The dev overlay sets a throwaway password itself and does not read this.
POSTGRES_PASSWORD=
