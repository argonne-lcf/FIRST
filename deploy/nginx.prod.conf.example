# One server per gateway replica (compose.prod.yaml publishes 7001-7004).
# least_conn picks, per request, the replica with the fewest in flight;
# max_fails takes one that stops answering out of rotation for a while.
# The zone shares those in-flight counts and failure marks across nginx's
# worker processes; without it each worker balances and fails over alone.
upstream app_server {
    zone app_server 64k;
    least_conn;
    server 127.0.0.1:7001 max_fails=3 fail_timeout=5s;
    server 127.0.0.1:7002 max_fails=3 fail_timeout=5s;
    server 127.0.0.1:7003 max_fails=3 fail_timeout=5s;
    server 127.0.0.1:7004 max_fails=3 fail_timeout=5s;
    # Reuse connections to the gateway; without this nginx opens one per
    # request and can exhaust local ports under load. Requires the
    # `Connection $connection_upgrade` header below (empty for plain requests).
    keepalive 128;
    # Below the gateway's own keep-alive (uvicorn --timeout-keep-alive 75).
    keepalive_timeout 60s;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      "";
}

# The CELS front-end proxies forward requests to this host. The client address
# is taken from X-Forwarded-For only when the request comes from one of these
# proxies; otherwise $remote_addr stays the socket peer. Replace the
# placeholders with the real front-end proxy ranges.
set_real_ip_from <CELS-FRONT-END-PROXY-RANGE-1>;   # <-- placeholder
set_real_ip_from <CELS-FRONT-END-PROXY-RANGE-2>;   # <-- placeholder
real_ip_header X-Forwarded-For;

# Rate limit keyed per client address (as resolved by real_ip above).
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=50r/s;
limit_req_status 429;

# Analytics Grafana (/dashboard/). Logins and dashboard loads only: much lower
# than the API, but a dashboard fires one request per panel.
limit_req_zone $binary_remote_addr zone=dashboard_limit:10m rate=20r/s;

# Analytics Grafana on inference-olap-01, over verified TLS. Its server
# certificate is signed by the FIRST-analytics CA: copy that CA's public
# certificate (clickhouse/certs/ca.crt on the analytics VM) to the path below.
upstream analytics_grafana {
    server inference-olap-01.cels.anl.gov:3000;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name inference-api.alcf.anl.gov;
    client_max_body_size 20M;

    ssl_certificate     /etc/ssl/first/fullchain.pem;
    ssl_certificate_key /etc/ssl/first/privkey.pem;

    # No admin routes here: the admin API and the admin console are served only
    # by controller-manager on 127.0.0.1:9100. Do not proxy to that port.

    # Analytics Grafana. GF_SERVER_ROOT_URL is .../dashboard/, and the trailing
    # slash on proxy_pass strips the prefix (Grafana does not serve from a sub
    # path). Login is Globus OAuth with browser cookies only.
    location /dashboard/ {
        limit_req zone=dashboard_limit burst=100 nodelay;

        proxy_pass https://analytics_grafana/;
        proxy_http_version 1.1;
        # Grafana Live (/api/live/ws) is a WebSocket.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # No header-based authentication from the internet: basic auth is off
        # in Grafana, and service-account tokens are for on-host use only.
        proxy_set_header Authorization "";
        proxy_redirect off;

        # Verify Grafana's certificate (nginx does not by default).
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 1;
        proxy_ssl_trusted_certificate /etc/ssl/first/analytics-ca.crt;
        proxy_ssl_name inference-olap-01.cels.anl.gov;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_session_reuse on;

        # Grafana sets X-Frame-Options and its other security headers itself.
        add_header Strict-Transport-Security "max-age=31536000" always;

        proxy_read_timeout 300s;
    }

    location / {
        limit_req zone=api_limit burst=50 nodelay;

        proxy_pass http://app_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # The gateway logs this as the request's origin address.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Lets the gateway report time queued before it (Server-Timing "queue")
        proxy_set_header X-Request-Start "t=$msec";
        proxy_redirect off;

        # Stream SSE without buffering (preserves TTFT/ITL).
        proxy_buffering off;
        gzip off;

        proxy_connect_timeout 600s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        send_timeout 900s;
    }
}
