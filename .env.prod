# Non-secret settings specific to production deployment.
# Loaded only by the prod overlay (deploy/compose.prod.yaml).

FIRST_REDIS_URL="redis://redis:6380/1"
FIRST_GATEWAY_HEALTH_URL=http://inference-gateway:7000/health

# Log shipping is part of prod: the health alerter checks Vector and each
# prompt shipper named here (docs/deployment/log-shipping.md).
FIRST_LOG_SHIPPING__PROMPT_SHIPPERS=["v2", "v1"]

# Secrets live in per-service files on the prod host (not tracked), one per
# example: .env.gateway.example, .env.controller.example, .env.postgres.example
# (and .env.log-shipping.example). FIRST_DB_URL goes in the gateway and
# controller files:
#   FIRST_DB_URL="postgresql+psycopg://first_gateway:<strong-password>@postgres:5432/first_gateway"
