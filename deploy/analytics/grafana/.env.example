# Copy to .env and edit. Used by compose.yaml and
# provisioning/datasources/clickhouse.yaml.
GRAFANA_IMAGE=grafana/grafana-oss:13.0.2
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=<set-a-strong-password>

# The URL browsers use. Grafana derives links and redirects from this.
GRAFANA_ROOT_URL=https://grafana.example.com/

# Must match clickhouse/.env's grafana user.
CLICKHOUSE_USER=grafana
CLICKHOUSE_PASSWORD=<same-as-clickhouse/.env CLICKHOUSE_GRAFANA_PASSWORD>

# VM2's address. Restrict it with a firewall rule.
BIND_ADDRESS=127.0.0.1
ANALYTICS_NETWORK=first-analytics
