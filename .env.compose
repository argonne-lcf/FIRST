# !!! WARNING !!!  Do not put secrets in this file.
# It is tracked in git.
# Sensitive variables go in the gitignored .env.secret* files instead.

# Settings specific to services running inside deploy/compose.yaml.
# This mainly serves to set hostnames correctly for compose-managed networks.

# The postgres container's own settings are in compose.dev.yaml.
FIRST_DB_URL="postgresql+psycopg://first_gateway:password@postgres:5432/first_gateway_dev"
FIRST_REDIS_URL="redis://redis:6380/1"
FIRST_GATEWAY_HEALTH_URL=http://inference-gateway:7000/health
