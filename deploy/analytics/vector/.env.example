# Copy to .env and edit. Used by compose.yaml and vector.yaml.
VECTOR_IMAGE=docker.io/timberio/vector:0.58.0-alpine

# ClickHouse TLS endpoint. CLICKHOUSE_HOST must be in the server certificate's
# SAN list (certs/clickhouse-san.cnf) and reachable from VM1 only.
CLICKHOUSE_HOST=vm2.example.com
CLICKHOUSE_HTTPS_PORT=8443
CLICKHOUSE_USER=vector
CLICKHOUSE_PASSWORD=<same-as-clickhouse/.env CLICKHOUSE_VECTOR_PASSWORD>

# CA that signed the ClickHouse server certificate. Copy
# clickhouse/certs/ca.crt to this path on VM1.
CLICKHOUSE_TLS_CA_PATH=./certs/ca.crt

# Only read when the S3 raw archive is enabled (vector-archive.yaml).
S3_ENDPOINT=https://netapp-s3.internal
S3_BUCKET=inference-logs
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<put-object-only-credential>
S3_SECRET_ACCESS_KEY=<put-object-only-secret>
